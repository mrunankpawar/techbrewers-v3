# Copy to .env.local for local development.

# Descope project (sign-in)
NEXT_PUBLIC_DESCOPE_PROJECT_ID=

# Postgres for member cards, events, RSVPs and badges.
# On Vercel, adding Neon Postgres from the Storage tab sets these for you.
DATABASE_URL=
# POSTGRES_URL is also accepted.

# Optional: a short Claude-written intro on buddy matches.
# Without it, matches still show with plain reasons.
ANTHROPIC_API_KEY=

# Local development only (ignored in production builds):
# sign in as a fake user without Descope, optionally as an organizer.
# DEV_AUTH_USER_ID=dev-organizer
# DEV_AUTH_ORGANIZER=1
